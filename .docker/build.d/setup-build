#!/usr/bin/env bash

    set -e

    # Default RATIO value if not set
    RATIO="${B19_BUILD_PROC_RATIO}"
    # Calculate the number of jobs based on nproc and RATIO
    # Ensure integer division and handle edge cases
    CPU_COUNT=$(nproc)
    JOBS=$(awk -v cpus="${CPU_COUNT}" -v ratio="${RATIO}" 'BEGIN {
      jobs = int(cpus * ratio);
      if (jobs < 1) jobs = 1; # Ensure at least 1 job
      print jobs;
    }')

    CARGO_BUILD_JOBS="${JOBS}"
    export CARGO_BUILD_JOBS

    b19-log info "BUILD" "Using ${JOBS} jobs out of ${CPU_COUNT} CPUs with RATIO=${RATIO}"

    RUSTVERSION=$(rustc --version)

    WANTED_RUSTFLAGS_FILE="/app/.rustflags/${TARGETARCH}/flags.txt"
    SELECTED_FLAGS_FILE="/app/.rustflags/${TARGETARCH}/all.txt"
    DUMMY_RS_FILE="/tmp/dummy.rs"

    cat /app/.rustflags/"${TARGETARCH}"/flags.d/*.txt | decomment > "${WANTED_RUSTFLAGS_FILE}"

    # Create a simple test Rust program
    echo 'fn main() {}' > "${DUMMY_RS_FILE}"

    # Clear the SELECTED_FLAGS_FILE
    echo > "${SELECTED_FLAGS_FILE}"

    # Iterate through each flag in WANTED_RUSTFLAGS_FILE
    while read -r FLAG; do
        # Attempt to compile the dummy program with the flag
        if RUSTFLAGS="${FLAG}" rustc "${DUMMY_RS_FILE}" -o /tmp/dummy-out 2>/dev/null; then
            echo "${FLAG}" >> "${SELECTED_FLAGS_FILE}"
        else
            b19-log bad "RUSTC" "Not supported: ${FLAG}"
        fi
    done < "${WANTED_RUSTFLAGS_FILE}"

    # Clean up
    rm -f "${DUMMY_RS_FILE}" /tmp/dummy-out

    # Logging and build setup
    b19-log info "BUILD" "Setup flags for ${TARGETARCH} and ${RUSTVERSION}"

    RUSTFLAGS=$(tr '\n' ' ' < "${SELECTED_FLAGS_FILE}")
    export RUSTFLAGS

    b19-log good "BUILD" "RUSTFLAGS: ${RUSTFLAGS}"
    b19-log good "BUILD" "CARGO_BUILD_JOBS: ${CARGO_BUILD_JOBS}"

    # --- Compile cache activation ---
    case "${B19_COMPILE_CACHE}" in
      sccache)
        SCCACHE_DIR="${B19_COMPILE_CACHE_PATH}/sccache"
        RUSTC_WRAPPER=/usr/local/bin/sccache
        b19-run "BUILD" "$(_ "Create sccache cache directory")" mkdir -p "${SCCACHE_DIR}"
        export SCCACHE_DIR RUSTC_WRAPPER
        if [ -n "${B19_COMPILE_CACHE_REDIS}" ]; then
          SCCACHE_REDIS_ENDPOINT="${B19_COMPILE_CACHE_REDIS}"
          export SCCACHE_REDIS_ENDPOINT
          b19-log info "BUILD" "$(_p "Compile cache: sccache + Redis (%s)" "${SCCACHE_REDIS_ENDPOINT}")"
        else
          b19-log info "BUILD" "$(_p "Compile cache: sccache (%s)" "${SCCACHE_DIR}")"
        fi
        ;;
      off)
        unset RUSTC_WRAPPER
        b19-log warn "BUILD" "$(_ "Compile cache: off")"
        ;;
      ccache)
        b19-log bad "BUILD" "$(_ "ccache does not support Rust, disabling compile cache")"
        unset RUSTC_WRAPPER
        ;;
    esac
