build-essential                          # Informational list of build-essential packages
git                                      # fast, scalable, distributed revision control system
libssl-dev                               # SSL development libraries (needed for cargo install)
musl-tools                               # musl libc cross-compilation support (needed for musl Rust target)
pkg-config                               # manage compile and link flags for libraries (transitional package)
